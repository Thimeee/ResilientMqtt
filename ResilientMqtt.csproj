<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<RootNamespace>ResilientMqtt</RootNamespace>
		<AssemblyName>ResilientMqtt</AssemblyName>

		<!-- NuGet Package Metadata -->
		<PackageId>ResilientMqtt</PackageId>
		<Version>1.1.0-rc.1</Version>
		<Authors>H.A.T.S Thisera</Authors>
		<Company>MCS Computer Systems (Pvt) Limited</Company>
		<Product>ResilientMqtt</Product>
		<Description>
			Production-grade MQTT client wrapper for banking and IoT workloads.
			Features: auto-reconnect with jittered exponential backoff, circuit breaker,
			offline message buffering, broker-side Last Will &amp; Testament, idle-aware
			health checks, classified failure reasons + connection info, MQTT 5 sessions, mutual TLS,
			concurrent dispatch, and pluggable persistence. Drop-in for ASP.NET Core, Worker
			Services, Blazor, WPF, and Console apps.
		</Description>
		<PackageTags>mqtt;iot;banking;resilience;circuit-breaker;mqttnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>USAGE.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<RepositoryUrl>https://github.com/Thimeee/ResilientMqtt</RepositoryUrl>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<PackageIcon>icon.jpeg</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- NuGet package readme. File lives under docs/; packed at the package root as USAGE.md to
		     match PackageReadmeFile. No CopyToOutputDirectory — a readme isn't a build output, and the
		     old root path + copy was a build blocker (MSB3030: USAGE.md not found). (#18) -->
		<None Include="docs\USAGE.md" Pack="true" PackagePath="\USAGE.md" />
	</ItemGroup>
	<ItemGroup>
		<None Include="icon.jpeg" Pack="true" PackagePath="\">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<!-- Trim-safety for config binding (#18) — keeps the options POCOs' properties under IL trimming
		     so appsettings.json binding still works in trimmed/AOT publishes. -->
		<EmbeddedResource Include="ILLink.Descriptors.xml">
			<LogicalName>ILLink.Descriptors.xml</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<!-- Tests live in tests/ (own project) — keep them out of the library build and package. -->
		<Compile Remove="tests\**" />
		<None Remove="tests\**" />
		<EmbeddedResource Remove="tests\**" />
		<InternalsVisibleTo Include="ResilientMqtt.Tests" />
		<InternalsVisibleTo Include="ResilientMqtt.ChaosTests" />
		<InternalsVisibleTo Include="ResilientMqtt.LoadTest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MQTTnet" Version="5.1.0.1559" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>



</Project>